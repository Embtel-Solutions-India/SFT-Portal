# ==============================================================================
# embtel.com School For Staffing (SFS) Server Environment Template
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Connection String (Atlas or Local)
# Atlas: mongodb+srv://<username>:<password>@<cluster-url>/embtel_sfs?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/embtel_sfs
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/embtel_sfs?retryWrites=true&w=majority
MONGODB_DB_NAME=embtel_sfs

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h

# Google Gemini (resume parsing + advisory matching)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public URL of the web app (used in email links)
APP_URL=http://localhost:5173

# Set to 1 when behind a reverse proxy / load balancer (correct client IP for rate limiting)
TRUST_PROXY=

# Password applied to seeded demo users on first start (required in production if seed users exist)
SEED_USER_PASSWORD=

# AWS S3 resume storage (credentials via standard AWS env/profile/IAM role)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional: S3-compatible endpoint (MinIO/LocalStack) for local dev
S3_ENDPOINT=

# Mail: Brevo transactional API (preferred). Get the key at Brevo > SMTP & API > API Keys (starts with xkeysib-)
BREVO_API_KEY=
MAIL_FROM_NAME=School For Training

# Alternative: SMTP (used only when BREVO_API_KEY is empty). Brevo SMTP: smtp-relay.brevo.com:587 with your SMTP login + SMTP key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@schoolfortraining.com

